{
  "folders": [
    {
      "name": "bullet-root",
      "path": "."
    },
    {
      "name": "config",
      "path": "config"
    },
    {
      "path": "projects/bullet_render"
    },
    {
      "path": "projects/mcap_bagger"
    },
    {
      "path": "projects/bullet_drone"
    },
    {
      "name": "docs",
      "path": "docs"
    },
    {
      "path": "projects/bullet_msgs"
    },
    {
      "path": "projects/los_tracking"
    },
    {
      "path": "projects/bullet_app"
    },
    {
      "path": "projects/msp_link"
    },
    {
      "path": "projects/flight_lens"
    },
    {
      "path": "projects/bullet_view"
    },
    {
      "path": "projects/bullet_perception"
    },
    {
      "path": "projects/bullet_visual"
    },
    {
      "path": "projects/bullet_bringup"
    },
    {
      "path": "projects/msp_telem_logger"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Bullet: Run all",
        "type": "process",
        "command": "bash",
        "args": [
          "tools/run_all.sh",
          "${input:flightProfile}",
          "${input:droneModel}"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet-root}"
        },
        "problemMatcher": [
          "$gcc"
        ],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        },
        "detail": "Select backend and drone model. config/operator_controls.yaml selects manual Arm/Start and MAVLink recording in Bullet View. Start the Godot session, then Arm and Start mission in Bullet View. MCAP files go to workspace-root recordings/."
      },
      {
        "label": "FlightLens: Open",
        "type": "process",
        "command": "uv",
        "args": [
          "run",
          "--locked",
          "--extra",
          "assistant",
          "--package",
          "flight-lens",
          "flight-lens",
          "--config",
          "config/flight_lens.yaml"
        ],
        "options": {
          "cwd": "${workspaceFolder:flight_lens}"
        },
        "problemMatcher": []
      },
      {
        "label": "Bullet View: Open",
        "type": "process",
        "command": "uv",
        "args": [
          "run",
          "--locked",
          "--package",
          "bullet-view",
          "bullet-view"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_view}"
        },
        "problemMatcher": []
      },
      {
        "label": "Bullet Visual: Open",
        "type": "process",
        "command": "uv",
        "args": [
          "run",
          "--locked",
          "--package",
          "bullet-visual",
          "bullet-visual",
          "--config",
          "config/zmq.yaml"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_visual}"
        },
        "problemMatcher": []
      },
      {
        "label": "Bullet: Build Betaflight SITL",
        "type": "process",
        "command": "bash",
        "args": [
          "tools/setup_betaflight_sitl.sh"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet_drone}"
        },
        "problemMatcher": [
          "$gcc"
        ]
      },
      {
        "label": "Bullet: Build Python wheel",
        "type": "process",
        "command": "uv",
        "args": [
          "build",
          "--package",
          "${input:wheelProject}",
          "--wheel",
          "--out-dir",
          "${workspaceFolder:bullet-root}/deploy"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet-root}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        },
        "detail": "Select a Python project and build its .whl into workspace-root deploy/. Existing wheels for other projects are retained."
      },
      {
        "label": "Bullet: Build all Python wheels",
        "type": "process",
        "command": "uv",
        "args": [
          "build",
          "--all-packages",
          "--wheel",
          "--out-dir",
          "${workspaceFolder:bullet-root}/deploy"
        ],
        "options": {
          "cwd": "${workspaceFolder:bullet-root}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true
        },
        "runOptions": {
          "instanceLimit": 1
        },
        "detail": "Build all Python workspace packages into workspace-root deploy/. No project selection is required; non-package projects are skipped."
      }
    ],
    "inputs": [
      {
        "id": "flightProfile",
        "type": "pickString",
        "description": "Select the backend and matching profiles",
        "options": [
          "internal",
          "betaflight"
        ],
        "default": "betaflight"
      },
      {
        "id": "droneModel",
        "type": "pickString",
        "description": "Select the packaged drone URDF/configuration",
        "options": [
          "racer",
          "heavy_quad"
        ],
        "default": "racer"
      },
      {
        "id": "wheelProject",
        "type": "pickString",
        "description": "Select the Python project to build as a wheel",
        "options": [
          {
            "label": "bullet_app",
            "value": "bullet-app"
          },
          {
            "label": "bullet_bringup",
            "value": "bullet-bringup"
          },
          {
            "label": "bullet_drone",
            "value": "bullet-drone"
          },
          {
            "label": "bullet_msgs",
            "value": "bullet-msgs"
          },
          {
            "label": "bullet_perception",
            "value": "bullet-perception"
          },
          {
            "label": "bullet_view",
            "value": "bullet-view"
          },
          {
            "label": "bullet_visual",
            "value": "bullet-visual"
          },
          {
            "label": "flight_lens",
            "value": "flight-lens"
          },
          {
            "label": "los_tracking",
            "value": "los-tracking"
          },
          {
            "label": "mcap_bagger",
            "value": "mcap-bagger"
          },
          {
            "label": "msp_link",
            "value": "msp-link"
          },
          {
            "label": "msp_telem_logger",
            "value": "msp-telem-logger"
          }
        ],
        "default": "bullet-app"
      }
    ]
  },
  "settings": {
    "git.autoRepositoryDetection": true
  }
}
